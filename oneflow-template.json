          "scheduled_policies": []
        },
        {
          "name": "Web",
          "type": "vm",
          "template_id": 1,
          "cardinality": 1,
          "min_vms": 1,
          "max_vms": 2,
          "parents": [
            "LB"
          ],
          "elasticity_policies": [
            {
              "expression": "CPU > 50",
              "type": "CHANGE",
